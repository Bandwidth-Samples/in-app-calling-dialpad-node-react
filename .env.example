# Client-visible (React) — baked into bundle
REACT_APP_ACCOUNT_ID=
REACT_APP_ACCOUNT_USERNAME=

# Server-side only (never prefixed with REACT_APP_)
# OAuth2 client credentials for the backend's GET /access-token endpoint
BW_ID_CLIENT_ID=
BW_ID_CLIENT_SECRET=

# Optional
# BW_ID_HOSTNAME=https://api.bandwidth.com
# PORT=3000
